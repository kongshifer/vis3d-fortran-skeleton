<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Vis3D</AssemblyName>
    <RootNamespace>Vis3D.App</RootNamespace>
    <Product>Vis3D</Product>
    <Company>Vis3D Project</Company>
    <Description>Desktop workspace for MCX and MCNP to VTK conversion.</Description>
    <Version>1.3.1</Version>
    <FileVersion>1.3.1.0</FileVersion>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <InformationalVersion>1.3.1</InformationalVersion>
    <ApplicationIcon>..\assets\vis3d.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
